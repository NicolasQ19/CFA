# Copiar este archivo a .env.local y completar con los datos de tu proyecto de Supabase
# (Project Settings -> API en https://app.supabase.com)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon

# Project Settings -> API -> service_role (secreta, NUNCA con prefijo NEXT_PUBLIC_).
# Se usa solo en el servidor para crear cuentas de administrador saltando RLS.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Clave inventada por vos para proteger /admin/registrarse. Se escribe en el campo
# "Clave de alta" del formulario; nunca se pasa por la URL. Compartila solo con
# quien deba poder crear cuentas de administrador.
ADMIN_REGISTRO_SECRETO=elegí-una-clave-larga-y-al-azar
